# Copy to .env and fill in real values. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/deacondb?sslmode=require"

# Auth (self-managed — password hashing via Argon2id, sessions in the DB)
# Leave PORT/CLIENT_ORIGIN as-is for local dev.
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Optional: change the session lifetime in days (default 7).
# SESSION_TTL_DAYS=7

# Seeding (server/prisma/seed.ts)
# The email the seeded admin account is created with. Empty means
# admin@example.com. The account logs in with SEED_ADMIN_PASSWORD below.
SEED_ADMIN_EMAIL=""
# REQUIRED when running npm run db:seed — the seeded admin account's password.
# Pick something strong and unique; this is the first account you log in with.
SEED_ADMIN_PASSWORD="change-me-to-a-strong-password"