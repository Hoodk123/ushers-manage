# Copy to .env and fill in real values. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/deacondb?sslmode=require"

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
# Svix signing secret — Clerk Dashboard > Webhooks > your endpoint > Signing Secret.
# Optional locally (webhook sync can't run without it); required in production.
CLERK_WEBHOOK_SECRET="whsec_..."

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Seeding (server/prisma/seed.ts)
# The email the seed admin is created with (default admin@example.com). Set it to
# the address you actually sign into Clerk with; plus-tagged test addresses like
# admin+clerk_test@example.com also link to the base address at runtime.
SEED_ADMIN_EMAIL="admin+clerk_test@example.com"
# Optional: link the seed admin straight to a Clerk account at seed time (a
# Clerk user id looks like user_2abc...). Leave empty and the API will JIT-link
# by email on the first authenticated request — recommended, since it always
# follows whichever Clerk account you actually sign in with.
SEED_ADMIN_CLERK_ID=""