# Copy to .env and fill in real values. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/deacondb?sslmode=require"

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
# Svix signing secret — Clerk Dashboard > Webhooks > your endpoint > Signing Secret.
# Optional locally (webhook sync can't run without it); required in production.
CLERK_WEBHOOK_SECRET="whsec_..."

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"